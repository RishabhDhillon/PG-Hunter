---
import { Video, Mic, BadgeCheck, ShieldCheck } from '@lucide/astro';

const features = [
  {
    Icon: Video,
    title: 'Video Walkthroughs',
    body: 'See the room, washroom and building before you visit.',
  },
  {
    Icon: Mic,
    title: 'Owner Interviews',
    body: 'Real owners talk about the PG — rules, food and vibes.',
  },
  {
    Icon: BadgeCheck,
    title: 'Verified Listings',
    body: 'Listings carry their real verification status, nothing more.',
  },
  {
    Icon: ShieldCheck,
    title: 'Safety First',
    body: 'Area safety, girls PG zones and student-focused guidance.',
  },
];
---

<section aria-labelledby="trust-heading" class="border-y border-slate-100 bg-slate-50/60">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h2 id="trust-heading" class="sr-only">Why use PG Hunter</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {features.map(({ Icon, title, body }) => (
        <div class="flex items-start gap-3.5">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
            <Icon class="h-5 w-5" />
          </span>
          <div>
            <h3 class="text-sm font-bold text-slate-900">{title}</h3>
            <p class="mt-0.5 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
